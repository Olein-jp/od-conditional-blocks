{"translation-revision-date":"2026-11-17 14:20+0900","generator":"WP-CLI\/2.12.0","source":"src\/conditional\/edit.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Remove ELSE and its content?":["ELSE \u3068\u305d\u306e\u5185\u5bb9\u3092\u524a\u9664\u3057\u307e\u3059\u304b\uff1f"],"This deletes all content in ELSE. You can undo this change.":["ELSE \u5185\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u3059\u3079\u3066\u524a\u9664\u3057\u307e\u3059\u3002\u3053\u306e\u64cd\u4f5c\u306f\u53d6\u308a\u6d88\u305b\u307e\u3059\u3002"],"Cancel":["\u30ad\u30e3\u30f3\u30bb\u30eb"],"Remove ELSE":["ELSE \u3092\u524a\u9664"],"Display conditions":["\u8868\u793a\u6761\u4ef6"],"Enable conditions":["\u6761\u4ef6\u3092\u6709\u52b9\u306b\u3059\u308b"],"When disabled, IF is displayed. Invalid structure always produces no output.":["\u7121\u52b9\u306b\u3059\u308b\u3068 IF \u3092\u8868\u793a\u3057\u307e\u3059\u3002\u69cb\u9020\u304c\u4e0d\u6b63\u306a\u5834\u5408\u306f\u5e38\u306b\u4f55\u3082\u51fa\u529b\u3057\u307e\u305b\u3093\u3002"],"Admin label":["\u7ba1\u7406\u7528\u30e9\u30d9\u30eb"],"Conditions are missing or invalid. Neither branch will appear on the public site.":["\u6761\u4ef6\u304c\u672a\u8a2d\u5b9a\u307e\u305f\u306f\u4e0d\u6b63\u3067\u3059\u3002\u516c\u958b\u30da\u30fc\u30b8\u306b\u306f\u3069\u3061\u3089\u306e\u5206\u5c90\u3082\u8868\u793a\u3057\u307e\u305b\u3093\u3002"],"Edit branch":["\u7de8\u96c6\u3059\u308b\u5206\u5c90"],"Both":["\u4e21\u65b9"],"Add ELSE":["ELSE \u3092\u8ffd\u52a0"],"Conditional":["\u6761\u4ef6\u5206\u5c90"],"IF and ELSE":["IF \u3068 ELSE"],"Invalid branch structure. Keep one IF followed by at most one ELSE. No public output will be produced.":["\u5206\u5c90\u69cb\u9020\u304c\u4e0d\u6b63\u3067\u3059\u3002IF \u30921\u3064\u3001\u7d9a\u3044\u3066 ELSE \u3092\u6700\u59271\u3064\u914d\u7f6e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u516c\u958b\u30da\u30fc\u30b8\u306b\u306f\u4f55\u3082\u51fa\u529b\u3057\u307e\u305b\u3093\u3002"],"No ELSE branch. A false condition produces no output.":["ELSE \u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6761\u4ef6\u306b\u4e00\u81f4\u3057\u306a\u3044\u5834\u5408\u306f\u4f55\u3082\u51fa\u529b\u3057\u307e\u305b\u3093\u3002"]}}}