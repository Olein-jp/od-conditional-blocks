#. Plugin Name of the plugin
#: od-conditional-blocks.php
msgid "OD Conditional Blocks"
msgstr "OD Conditional Blocks"

#. Plugin URI of the plugin
#: od-conditional-blocks.php
msgid "https://github.com/Olein-jp/od-conditional-blocks"
msgstr "https://github.com/Olein-jp/od-conditional-blocks"

#. Description of the plugin
#: od-conditional-blocks.php
msgid "Server-side IF / ELSE display conditions for nested blocks."
msgstr "入れ子のブロックをサーバー側の IF / ELSE 条件で表示します。"

#. Author of the plugin
#: od-conditional-blocks.php
msgid "Koji Kuno"
msgstr "Koji Kuno"

#. Author URI of the plugin
#: od-conditional-blocks.php
msgid "https://olein-design.com"
msgstr "https://olein-design.com"

#: od-conditional-blocks.php:68
msgid "OD Conditional Blocks: Dependencies are missing. Install the ZIP from GitHub Releases or run composer install in the plugin directory."
msgstr "OD Conditional Blocks: 依存関係が不足しています。GitHub Releases の ZIP をインストールするか、プラグインディレクトリで composer install を実行してください。"

#: build/conditional/index.js:1
#: src/target-token-field.js:52
msgid "Choose existing targets from the suggestions. Remove a token to deselect it."
msgstr "候補から対象を選択してください。選択を解除するにはトークンを削除します。"

