#: build/conditional/index.js:2
#: src/condition-editor.js:155
msgid "Categories could not be loaded. Check your permissions and taxonomy REST support."
msgstr "カテゴリーを取得できませんでした。権限とタクソノミーの REST 対応を確認してください。"

#: build/conditional/index.js:2
#: src/condition-editor.js:159
msgid "Archive targets could not be loaded. Check your permissions and taxonomy REST support."
msgstr "候補を読み込めません。権限とタクソノミーの REST API 対応をご確認ください。"

#: build/conditional/index.js:2
#: src/condition-editor.js:180
msgid "Matches any selected category assigned directly to the displayed post. NOT matches posts with none of them. Outside single post pages or with missing targets, neither branch is displayed."
msgstr "表示中の投稿に直接付与されたカテゴリーのいずれかに一致します。NOT では、どれにも属さない投稿に一致します。通常投稿の詳細ページ以外や対象が存在しない場合は、どちらの分岐も表示しません。"

#: build/conditional/index.js:2
#: src/condition-editor.js:184
msgid "Matches the requested archive, not terms assigned to a post in a loop. Missing or private targets produce no output."
msgstr "表示中のアーカイブを判定します。ループ内の投稿に属するタームの判定ではありません。削除済み・非公開の対象は何も出力しません。"

#: build/conditional/index.js:2
#: src/condition-editor.js:209
msgid "Match conditions"
msgstr "条件の組み合わせ"

#: build/conditional/index.js:2
#: src/condition-editor.js:214
msgid "All (AND)"
msgstr "すべて（AND）"

#: build/conditional/index.js:2
#: src/condition-editor.js:218
msgid "Any (OR)"
msgstr "いずれか（OR）"

#: build/conditional/index.js:2
#: src/condition-editor.js:229
msgid "Page type"
msgstr "表示しているページの種類"

#: build/conditional/index.js:2
#: src/condition-editor.js:252
msgid "Invert condition (NOT)"
msgstr "条件を反転する（NOT）"

#: build/conditional/index.js:2
#: src/condition-editor.js:271
msgid "Remove condition"
msgstr "条件を削除"

#: build/conditional/index.js:2
#: src/condition-editor.js:291
msgid "Add condition"
msgstr "条件を追加"

#: build/conditional/index.js:2
#: src/conditional/edit.js:93
msgid "Remove ELSE and its content?"
msgstr "ELSE とその内容を削除しますか？"

#: build/conditional/index.js:2
#: src/conditional/edit.js:100
msgid "This deletes all content in ELSE. You can undo this change."
msgstr "ELSE 内のコンテンツをすべて削除します。この操作は取り消せます。"

#: build/conditional/index.js:2
#: src/conditional/edit.js:109
msgid "Cancel"
msgstr "キャンセル"

#: build/conditional/index.js:2
#: src/conditional/edit.js:126
#: src/conditional/edit.js:208
msgid "Remove ELSE"
msgstr "ELSE を削除"

#: build/conditional/index.js:2
#: src/conditional/edit.js:133
msgid "Display conditions"
msgstr "表示条件"

#: build/conditional/index.js:2
#: src/conditional/edit.js:139
msgid "Enable conditions"
msgstr "条件を有効にする"

#: build/conditional/index.js:2
#: src/conditional/edit.js:145
msgid "When disabled, IF is displayed. Invalid structure always produces no output."
msgstr "無効にすると IF を表示します。構造が不正な場合は常に何も出力しません。"

#: build/conditional/index.js:2
#: src/conditional/edit.js:151
msgid "Admin label"
msgstr "管理用ラベル"

#: build/conditional/index.js:2
#: src/conditional/edit.js:163
msgid "No ELSE branch. A false condition produces no output."
msgstr "ELSE はありません。条件に一致しない場合は何も出力しません。"

#: build/conditional/index.js:2
#: src/conditional/edit.js:173
msgid "Conditions are missing or invalid. Neither branch will appear on the public site."
msgstr "条件が未設定または不正です。公開ページにはどちらの分岐も表示しません。"

#: build/conditional/index.js:2
#: src/conditional/edit.js:183
msgid "Edit branch"
msgstr "編集する分岐"

#: build/conditional/index.js:2
#: src/conditional/edit.js:202
msgid "Both"
msgstr "両方"

#: build/conditional/index.js:2
#: src/conditional/edit.js:213
msgid "Add ELSE"
msgstr "ELSE を追加"

#: build/conditional/index.js:2
#: src/conditional/edit.js:221
msgid "Invalid branch structure. Keep one IF followed by at most one ELSE. No public output will be produced."
msgstr "分岐構造が不正です。IF を1つ、続いて ELSE を最大1つ配置してください。公開ページには何も出力しません。"

#: build/else/index.js:1
#: build/if/index.js:1
#: src/branch-edit.js:15
msgid "IF: matches conditions"
msgstr "IF：条件に一致"

#: build/else/index.js:1
#: build/if/index.js:1
#: src/branch-edit.js:19
msgid "ELSE: does not match conditions"
msgstr "ELSE：条件に一致しない"

